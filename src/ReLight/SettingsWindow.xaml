<Window x:Class="ReLight.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:ReLight.Controls"
        Title="{DynamicResource Loc.settings.title}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="580"
        SizeToContent="Height"
        MaxHeight="1000"
        UseLayoutRounding="True"
        Background="{DynamicResource Rl.Window.Background}"
        Foreground="{DynamicResource Rl.Text.Primary}"
        FontFamily="{StaticResource Rl.Font}"
        FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Окно настроек в раскладке ReFlow: карточки секций, внизу «Отмена» и «Сохранить» -->
    <Border BorderBrush="{DynamicResource Rl.Border}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rl.Surface}"
                    BorderBrush="{DynamicResource Rl.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Loc.settings.title}" FontSize="15" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource Rl.TitleBar.AboutInfo}" Click="About_Click"
                                    ToolTip="{DynamicResource Loc.tip.about}" AutomationProperties.Name="{DynamicResource Loc.tip.about}"/>
                        </StackPanel>
                        <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Rl.Text.Muted}"
                                   Text="{DynamicResource Loc.settings.subtitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Rl.TitleBar.Close}" Content="&#x00D7;" Click="Cancel_Click"
                            ToolTip="{DynamicResource Loc.tip.close}" AutomationProperties.Name="{DynamicResource Loc.tip.close}"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="18,12,18,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Rl.Border}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Rl.Button}" MinWidth="120" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE711;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                            <TextBlock Text="{DynamicResource Loc.cal.cancel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Rl.Button.Accent}" MinWidth="130" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE74E;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                            <TextBlock Text="{DynamicResource Loc.settings.save}" Foreground="{DynamicResource Rl.Accent}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16,18,6">
                    <Border Style="{StaticResource Rl.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Foreground="{DynamicResource Rl.Text.Primary}"
                                       Text="{DynamicResource Loc.settings.language}"/>
                            <ComboBox x:Name="LanguageBox" Grid.Column="1"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Rl.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.settings.sec.start}"/>
                            <CheckBox x:Name="AutostartBox" Content="{DynamicResource Loc.settings.autostart}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="StartMinBox" Content="{DynamicResource Loc.settings.startMin}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="CloseTrayBox" Content="{DynamicResource Loc.settings.closeTray}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Rl.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.settings.sec.theme}"/>
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="{DynamicResource Loc.settings.theme.system}"/>
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="{DynamicResource Loc.settings.theme.dark}"/>
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="{DynamicResource Loc.settings.theme.light}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Rl.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.settings.sec.strip}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Rl.FieldLabel}" Foreground="{DynamicResource Rl.Text.Primary}" Text="{DynamicResource Loc.device.baud}"/>
                                <ComboBox x:Name="BaudBox" Grid.Column="1" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Rl.FieldLabel}" Foreground="{DynamicResource Rl.Text.Primary}" Text="{DynamicResource Loc.device.order}"/>
                                <ComboBox x:Name="OrderBox" Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Rl.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.settings.sec.screen}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Rl.FieldLabel}" Foreground="{DynamicResource Rl.Text.Primary}" Text="{DynamicResource Loc.settings.fps}"/>
                                <c:NumberSpinner x:Name="FpsBox" Grid.Column="1" Minimum="5" Maximum="60" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Rl.FieldLabel}" Foreground="{DynamicResource Rl.Text.Primary}" Text="{DynamicResource Loc.settings.depth}"/>
                                <c:NumberSpinner x:Name="DepthBox" Grid.Row="1" Grid.Column="1" Minimum="3" Maximum="45"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,10,0,0"
                                           Text="{DynamicResource Loc.settings.fps.hint}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Rl.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.settings.sec.hotkeys}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Rl.FieldLabel}" Foreground="{DynamicResource Rl.Text.Primary}" Text="{DynamicResource Loc.hk.toggle}"/>
                                <c:HotkeyBox x:Name="ToggleKeyBox" Grid.Column="1" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Rl.FieldLabel}" Foreground="{DynamicResource Rl.Text.Primary}" Text="{DynamicResource Loc.hk.mode}"/>
                                <c:HotkeyBox x:Name="ModeKeyBox" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,10,0,0"
                                           Text="{DynamicResource Loc.hk.hint}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
