<Window x:Class="ReLight.CinemaTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Loc.cinema.test.title}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Width="560"
        SizeToContent="Height"
        UseLayoutRounding="True"
        Background="{DynamicResource Rl.Window.Background}"
        Foreground="{DynamicResource Rl.Text.Primary}"
        FontFamily="{StaticResource Rl.Font}"
        FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Rl.Border}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rl.Surface}"
                    BorderBrush="{DynamicResource Rl.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.cinema.test.title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Rl.Text.Muted}"
                                   Text="{DynamicResource Loc.cinema.test.subtitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Rl.TitleBar.Close}" Content="&#x00D7;" Click="Close_Click"
                            ToolTip="{DynamicResource Loc.tip.close}" AutomationProperties.Name="{DynamicResource Loc.tip.close}"/>
                </Grid>
            </Border>

            <StackPanel Margin="18,16,18,16">
                <!-- Уменьшенный кадр, который читает лента: полосы затенены, области светодиодов обведены их цветом -->
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Rl.Border}" Background="Black"
                        MinHeight="200" MaxHeight="360" ClipToBounds="True">
                    <Grid>
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="Frame" Width="160" Height="90">
                                <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Canvas x:Name="Overlay"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="Waiting" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Rl.Text.Muted}" Text="{DynamicResource Loc.cinema.test.wait}"/>
                    </Grid>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.cinema.test.picture}"/>
                    <TextBlock x:Name="BarsText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Rl.FieldLabel}" Margin="0,10,14,0" Text="{DynamicResource Loc.cinema.sound}"/>
                    <Border x:Name="SwellTrack" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Height="8" CornerRadius="4"
                            Background="{DynamicResource Rl.Track}" VerticalAlignment="Center">
                        <Border x:Name="SwellMeter" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource Rl.Accent}"/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource Loc.cinema.test.hint}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
