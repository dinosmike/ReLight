<Window x:Class="ReLight.ExclusionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Loc.ex.title}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="760"
        SizeToContent="Height"
        UseLayoutRounding="True"
        Background="{DynamicResource Rl.Window.Background}"
        Foreground="{DynamicResource Rl.Text.Primary}"
        FontFamily="{StaticResource Rl.Font}"
        FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Rl.Border}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rl.Surface}"
                    BorderBrush="{DynamicResource Rl.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.ex.title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Rl.Text.Muted}"
                                   Text="{DynamicResource Loc.ex.subtitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Rl.TitleBar.Close}" Content="&#x00D7;" Click="Cancel_Click"
                            ToolTip="{DynamicResource Loc.tip.close}" AutomationProperties.Name="{DynamicResource Loc.tip.close}"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="18,12,18,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Rl.Border}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Rl.Button}" MinWidth="120" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE711;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                            <TextBlock Text="{DynamicResource Loc.cal.cancel}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Rl.Button.Accent}" MinWidth="130" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE74E;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                            <TextBlock Text="{DynamicResource Loc.settings.save}" Foreground="{DynamicResource Rl.Accent}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Margin="18,16,18,6">
                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.ex.sec.programs}"/>
                        <TextBlock Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,-6,0,12" Text="{DynamicResource Loc.ex.hint}"/>

                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Rl.Border}"
                                Background="{DynamicResource Rl.Input}" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock x:Name="EmptyText" Style="{StaticResource Rl.Muted}" Margin="14,16" TextAlignment="Center"
                                           Text="{DynamicResource Loc.ex.empty}"/>
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RulesList"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Rl.Button}" Margin="0,0,8,0" Click="AddFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE8E5;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                    <TextBlock Text="{DynamicResource Loc.ex.add.file}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RunningButton" Grid.Column="1" Style="{StaticResource Rl.Button}" Margin="0,0,8,0" Click="Running_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE7C4;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                    <TextBlock Text="{DynamicResource Loc.ex.add.running}"/>
                                    <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE70D;" FontSize="9" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="RunningMenu"/>
                                </Button.ContextMenu>
                            </Button>
                            <!-- Прицел: зажать и отпустить над окном программы -->
                            <Border x:Name="Target" Grid.Column="2" CornerRadius="6" BorderThickness="1" Padding="10,0" MinHeight="36"
                                    BorderBrush="{DynamicResource Rl.Border}" Background="{DynamicResource Rl.Surface}" Cursor="Cross"
                                    ToolTip="{DynamicResource Loc.ex.target.hint}"
                                    MouseLeftButtonDown="Target_Down" MouseLeftButtonUp="Target_Up">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Canvas Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Width="14" Height="14" Canvas.Left="2" Canvas.Top="2" StrokeThickness="1.6" Stroke="{DynamicResource Rl.Accent}"/>
                                        <Ellipse Width="4" Height="4" Canvas.Left="7" Canvas.Top="7" Fill="{DynamicResource Rl.Accent}"/>
                                        <Line X1="9" Y1="0" X2="9" Y2="5" StrokeThickness="1.6" Stroke="{DynamicResource Rl.Accent}"/>
                                        <Line X1="9" Y1="13" X2="9" Y2="18" StrokeThickness="1.6" Stroke="{DynamicResource Rl.Accent}"/>
                                        <Line X1="0" Y1="9" X2="5" Y2="9" StrokeThickness="1.6" Stroke="{DynamicResource Rl.Accent}"/>
                                        <Line X1="13" Y1="9" X2="18" Y2="9" StrokeThickness="1.6" Stroke="{DynamicResource Rl.Accent}"/>
                                    </Canvas>
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Loc.ex.target}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,8,0,0" Text="{DynamicResource Loc.ex.target.hint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.ex.sec.engines}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Equal fixed rows: the color square is taller than a bare combo box, so Auto rows would differ -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="46"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="UnityBox" Content="{DynamicResource Loc.ex.unity}" VerticalAlignment="Center" Click="Engine_Click"/>
                            <ContentControl x:Name="UnityEditor" Grid.Column="1" VerticalAlignment="Center"/>
                            <CheckBox x:Name="UnrealBox" Grid.Row="1" Content="{DynamicResource Loc.ex.unreal}" VerticalAlignment="Center" Click="Engine_Click"/>
                            <ContentControl x:Name="UnrealEditor" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                            <CheckBox x:Name="PlayersBox" Grid.Row="2" Content="{DynamicResource Loc.ex.players}" VerticalAlignment="Center"
                                      ToolTip="{DynamicResource Loc.ex.players.tip}" Click="Engine_Click"/>
                            <ContentControl x:Name="PlayersEditor" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,10,0,0" Text="{DynamicResource Loc.ex.engines.hint}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
