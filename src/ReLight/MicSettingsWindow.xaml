<Window x:Class="ReLight.MicSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Loc.micset.title}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="560"
        SizeToContent="Height"
        UseLayoutRounding="True"
        Background="{DynamicResource Rl.Window.Background}"
        Foreground="{DynamicResource Rl.Text.Primary}"
        FontFamily="{StaticResource Rl.Font}"
        FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Rl.Border}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rl.Surface}"
                    BorderBrush="{DynamicResource Rl.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.micset.title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Rl.Text.Muted}"
                                   Text="{DynamicResource Loc.micset.subtitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Rl.TitleBar.Close}" Content="&#x00D7;" Click="Cancel_Click"
                            ToolTip="{DynamicResource Loc.tip.close}" AutomationProperties.Name="{DynamicResource Loc.tip.close}"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="18,12,18,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Rl.Border}">
                <Grid>
                    <Button Style="{StaticResource Rl.Button}" HorizontalAlignment="Left" Click="Reset_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE777;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                            <TextBlock Text="{DynamicResource Loc.fxe.reset}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Rl.Button}" MinWidth="110" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE711;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                <TextBlock Text="{DynamicResource Loc.cal.cancel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Rl.Button.Accent}" MinWidth="120" Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE74E;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                <TextBlock Text="{DynamicResource Loc.settings.save}" Foreground="{DynamicResource Rl.Accent}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="18,16,18,6" Grid.IsSharedSizeScope="True">
                <!-- Тишина -->
                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.micset.sec.silence}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.micset.gate}"/>
                            <Slider x:Name="GateSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Any_Changed"/>
                            <TextBlock x:Name="GateValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Живой индикатор громкости с отметкой порога -->
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.mic.level}"/>
                            <Grid x:Name="MeterArea" Grid.Column="1" Height="14" VerticalAlignment="Center">
                                <Border Height="8" CornerRadius="4" Background="{DynamicResource Rl.Track}"/>
                                <Border x:Name="Meter" Height="8" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource Rl.Accent}"/>
                                <Border x:Name="GateMark" Width="2" HorizontalAlignment="Left" Background="{DynamicResource Rl.Status.Warn}"/>
                            </Grid>
                        </Grid>
                        <TextBlock Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,0,0,12" Text="{DynamicResource Loc.micset.gate.hint}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="GlowBox" Content="{DynamicResource Loc.micset.glow}" Margin="0,0,14,0" VerticalAlignment="Center" Click="Any_Click"/>
                            <Slider x:Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Any_Changed"/>
                            <TextBlock x:Name="GlowValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Голос -->
                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource Loc.micset.sec.voice}"/>
                            <ToggleButton x:Name="VoiceToggle" Style="{StaticResource Rl.Power}" HorizontalAlignment="Right" Click="Any_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.micset.low}"/>
                            <Slider x:Name="LowHue" Grid.Column="1" Style="{StaticResource Rl.Slider.Hue}" VerticalAlignment="Center" ValueChanged="Any_Changed"/>
                            <Border x:Name="LowSwatch" Grid.Column="2" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.micset.high}"/>
                            <Slider x:Name="HighHue" Grid.Column="1" Style="{StaticResource Rl.Slider.Hue}" VerticalAlignment="Center" ValueChanged="Any_Changed"/>
                            <Border x:Name="HighSwatch" Grid.Column="2" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.micset.waves}"/>
                            <Slider x:Name="WaveSlider" Grid.Column="1" Minimum="1" Maximum="100" VerticalAlignment="Center" ValueChanged="Any_Changed"/>
                            <TextBlock x:Name="WaveValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Хлопки и стук -->
                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource Loc.micset.sec.claps}"/>
                            <ToggleButton x:Name="ClapsToggle" Style="{StaticResource Rl.Power}" HorizontalAlignment="Right" Click="Any_Click"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.micset.rings}"/>
                            <ComboBox x:Name="RingColorsBox" Grid.Column="1" SelectionChanged="Rings_Changed"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.micset.ringspeed}"/>
                            <Slider x:Name="RingSlider" Grid.Column="1" Minimum="1" Maximum="100" VerticalAlignment="Center" ValueChanged="Any_Changed"/>
                            <TextBlock x:Name="RingValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.micset.afterglow}"/>
                            <Slider x:Name="AfterSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Any_Changed"/>
                            <TextBlock x:Name="AfterValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,0,0,6" Text="{DynamicResource Loc.fxe.live}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
