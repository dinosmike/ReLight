<Window x:Class="ReLight.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ReLight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="420"
        SizeToContent="Height"
        UseLayoutRounding="True"
        Background="{DynamicResource Rl.Window.Background}"
        Foreground="{DynamicResource Rl.Text.Primary}"
        FontFamily="{StaticResource Rl.Font}"
        FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Сообщение в оформлении ReLight вместо системного MessageBox -->
    <Border BorderBrush="{DynamicResource Rl.Border}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rl.Surface}"
                    BorderBrush="{DynamicResource Rl.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                        <Image x:Name="TitleBarIcon" Width="26" Height="26" Margin="0,0,10,0"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Rl.TitleBar.Close}" Content="&#x00D7;"
                            ToolTip="{DynamicResource Loc.tip.close}" AutomationProperties.Name="{DynamicResource Loc.tip.close}"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Border Padding="20,18,20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IconGlyph" Style="{StaticResource Rl.Icon}" FontSize="22" Margin="0,0,14,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource Rl.Accent}" Text="&#xE946;"/>
                        <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="CancelButton" Style="{StaticResource Rl.Button}" MinWidth="100" Margin="0,0,10,0"
                                Content="{DynamicResource Loc.cal.cancel}" IsCancel="True" Click="Cancel_Click" Visibility="Collapsed"/>
                        <Button x:Name="OkButton" Style="{StaticResource Rl.Button.Accent}" MinWidth="100"
                                Content="{DynamicResource Loc.about.ok}" IsDefault="True" Click="Ok_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
