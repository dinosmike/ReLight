<Window x:Class="ReLight.EffectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:ReLight.Controls"
        Title="ReLight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="520"
        SizeToContent="Height"
        UseLayoutRounding="True"
        Background="{DynamicResource Rl.Window.Background}"
        Foreground="{DynamicResource Rl.Text.Primary}"
        FontFamily="{StaticResource Rl.Font}"
        FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Rl.Border}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rl.Surface}"
                    BorderBrush="{DynamicResource Rl.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                        <Image x:Name="TitleBarIcon" Width="26" Height="26" Margin="0,0,10,0"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Rl.TitleBar.Close}" Content="&#x00D7;" Click="Cancel_Click"
                            ToolTip="{DynamicResource Loc.tip.close}" AutomationProperties.Name="{DynamicResource Loc.tip.close}"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="18,12,18,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Rl.Border}">
                <Grid>
                    <Button Style="{StaticResource Rl.Button}" HorizontalAlignment="Left" Click="Reset_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE777;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                            <TextBlock Text="{DynamicResource Loc.fxe.reset}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Rl.Button}" MinWidth="110" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE711;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                <TextBlock Text="{DynamicResource Loc.cal.cancel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Rl.Button.Accent}" MinWidth="120" Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE74E;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                <TextBlock Text="{DynamicResource Loc.settings.save}" Foreground="{DynamicResource Rl.Accent}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="18,14,18,6">
                <TextBlock x:Name="Description" Style="{StaticResource Rl.Muted}" Margin="0,0,0,12"/>

                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Rl.Border}"
                        Background="{DynamicResource Rl.Input}" Margin="0,0,0,12">
                    <c:EffectPreview x:Name="BigPreview" Height="150" Margin="8"/>
                </Border>

                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.fxe.colors}"/>
                        <TextBlock x:Name="ColorsHint" Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,-6,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <WrapPanel x:Name="Swatches" VerticalAlignment="Center"/>
                            <Button x:Name="AddButton" Style="{StaticResource Rl.Button.Icon}" Content="&#xE710;" Margin="4,0,6,0" Click="Add_Click"
                                    ToolTip="{DynamicResource Loc.fxe.add}" AutomationProperties.Name="{DynamicResource Loc.fxe.add}"/>
                            <Button x:Name="RemoveButton" Style="{StaticResource Rl.Button.Icon}" Content="&#xE738;" Click="Remove_Click"
                                    ToolTip="{DynamicResource Loc.fxe.remove}" AutomationProperties.Name="{DynamicResource Loc.fxe.remove}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.fxe.hue}"/>
                            <Slider x:Name="HueSlider" Grid.Column="1" Style="{StaticResource Rl.Slider.Hue}" Margin="0,0,0,6" ValueChanged="Color_Changed"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.fxe.sat}"/>
                            <Slider x:Name="SatSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Margin="0,0,0,6" ValueChanged="Color_Changed"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.fxe.bright}"/>
                            <Slider x:Name="ValSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="Color_Changed"/>
                            <StackPanel Grid.Column="2" Grid.RowSpan="3" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Border x:Name="ColorPreview" Width="44" Height="44" CornerRadius="22" BorderThickness="1"
                                        BorderBrush="{DynamicResource Rl.Border}" Margin="0,0,0,8"/>
                                <TextBox x:Name="HexBox" Width="84" TextAlignment="Center" CharacterCasing="Upper" MaxLength="7"
                                         TextChanged="Hex_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Rl.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.fxe.speed}"/>
                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="1" Maximum="100" VerticalAlignment="Center" ValueChanged="Speed_Changed"/>
                        <TextBlock x:Name="SpeedValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,0,0,6" Text="{DynamicResource Loc.fxe.live}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
