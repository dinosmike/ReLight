<Window x:Class="ReLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:ReLight.Controls"
        Title="ReLight"
        Icon="pack://application:,,,/app.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Rl.Window.Background}"
        Foreground="{DynamicResource Rl.Text.Primary}"
        FontFamily="{StaticResource Rl.Font}"
        FontSize="13"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Rl.Border}" BorderThickness="1">
        <DockPanel>
            <!-- Заголовок окна -->
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rl.Surface}"
                    BorderBrush="{DynamicResource Rl.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ReLight" FontSize="15" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource Rl.TitleBar.AboutInfo}" Click="About_Click"
                                    ToolTip="{DynamicResource Loc.tip.about}" AutomationProperties.Name="{DynamicResource Loc.tip.about}"/>
                        </StackPanel>
                        <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Rl.Text.Muted}"
                                   Text="{DynamicResource Loc.app.subtitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Rl.TitleBar.IconButton}" Click="Settings_Click" Content="&#xE713;"
                                ToolTip="{DynamicResource Loc.tip.settings}" AutomationProperties.Name="{DynamicResource Loc.tip.settings}"/>
                        <Button x:Name="LangButton" Style="{StaticResource Rl.TitleBar.Lang}" Click="Lang_Click" Content="Ru"
                                ToolTip="{DynamicResource Loc.tip.lang}" AutomationProperties.Name="{DynamicResource Loc.tip.lang}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="LangRu" Header="Русский" Tag="ru" Click="LangItem_Click"/>
                                    <MenuItem x:Name="LangEn" Header="English" Tag="en" Click="LangItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource Rl.TitleBar.Button}" Click="ToTray_Click" Content="&#x2B07;" FontSize="14"
                                ToolTip="{DynamicResource Loc.tip.tray}" AutomationProperties.Name="{DynamicResource Loc.tip.tray}"/>
                        <Button Style="{StaticResource Rl.TitleBar.Button}" Click="Minimize_Click" Content="&#x2212;"
                                ToolTip="{DynamicResource Loc.tip.minimize}" AutomationProperties.Name="{DynamicResource Loc.tip.minimize}"/>
                        <Button Style="{StaticResource Rl.TitleBar.Close}" Click="Close_Click" Content="&#x00D7;"
                                ToolTip="{DynamicResource Loc.tip.close}" AutomationProperties.Name="{DynamicResource Loc.tip.close}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Если окно не помещается по высоте (маленький экран), содержимое прокручивается -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,16,18,8">
                <!-- Лента: состояние в строке заголовка, порт с подключением одной строкой, ниже яркость -->
                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Margin="0" VerticalAlignment="Center"
                                       Text="{DynamicResource Loc.sec.strip}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusGlow" Width="14" Height="14" Opacity="0.25"/>
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8"/>
                                </Grid>
                                <TextBlock x:Name="StatusText" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.device.port}"/>
                            <ComboBox x:Name="PortBox" Grid.Column="1" SelectionChanged="Port_Changed" ToolTip="{DynamicResource Loc.port.hint}"/>
                            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Rl.Button.Icon}" Content="&#xE72C;" Click="Refresh_Click"
                                    ToolTip="{DynamicResource Loc.tip.refresh}" AutomationProperties.Name="{DynamicResource Loc.tip.refresh}"/>
                            <Button x:Name="ConnectButton" Grid.Column="3" Margin="8,0,0,0" MinWidth="120"
                                    Style="{StaticResource Rl.Button.Accent}" Click="Connect_Click"/>

                            <!-- Только при ошибке: что именно не так -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                                <TextBlock x:Name="StatusDetail" FontSize="11" Style="{StaticResource Rl.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="BusyHint" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource Rl.Status.Bad}" Text="{DynamicResource Loc.state.busy}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Style="{StaticResource Rl.FieldLabel}" Margin="0,12,14,0" Text="{DynamicResource Loc.device.brightness}"/>
                            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BrightnessSlider" Minimum="5" Maximum="100" VerticalAlignment="Center" ValueChanged="Brightness_Changed"/>
                                <TextBlock x:Name="BrightnessValue" Grid.Column="1" Margin="10,0,0,0" MinWidth="36"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Режим подсветки -->
                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Rl.SectionTitle}" Margin="0" VerticalAlignment="Center"
                                       Text="{DynamicResource Loc.sec.mode}"/>
                            <ToggleButton x:Name="PowerToggle" Style="{StaticResource Rl.Power}" HorizontalAlignment="Right"
                                          Checked="Power_Changed" Unchecked="Power_Changed"/>
                        </Grid>

                        <Border CornerRadius="8" BorderThickness="1" Padding="2"
                                BorderBrush="{DynamicResource Rl.Border}" Background="{DynamicResource Rl.Input}">
                            <!-- Ширина по надписи плюс поровну свободного места: подписи стоят на равных расстояниях -->
                            <c:SpreadPanel>
                                <RadioButton x:Name="ModeScreen" Style="{StaticResource Rl.ModeTab}" GroupName="Mode" Tag="&#xE7F4;"
                                             Content="{DynamicResource Loc.mode.Screen}" Checked="Mode_Checked"/>
                                <RadioButton x:Name="ModeColor" Style="{StaticResource Rl.ModeTab}" GroupName="Mode" Tag="&#xE790;"
                                             Content="{DynamicResource Loc.mode.Color}" Checked="Mode_Checked"/>
                                <RadioButton x:Name="ModeRainbow" Style="{StaticResource Rl.ModeTab}" GroupName="Mode" Tag="&#xE706;"
                                             Content="{DynamicResource Loc.mode.Rainbow}" Checked="Mode_Checked"/>
                                <RadioButton x:Name="ModeMusic" Style="{StaticResource Rl.ModeTab}" GroupName="Mode" Tag="&#xEC4F;"
                                             Content="{DynamicResource Loc.mode.Music}" Checked="Mode_Checked"/>
                                <RadioButton x:Name="ModeCinema" Style="{StaticResource Rl.ModeTab}" GroupName="Mode" Tag="&#xE8B2;"
                                             Content="{DynamicResource Loc.mode.Cinema}" Checked="Mode_Checked"/>
                                <RadioButton x:Name="ModeMic" Style="{StaticResource Rl.ModeTab}" GroupName="Mode" Tag="&#xE720;"
                                             Content="{DynamicResource Loc.mode.Mic}" Checked="Mode_Checked"/>
                            </c:SpreadPanel>
                        </Border>

                        <!-- Настройки выбранного режима -->
                        <Grid Margin="0,14,0,0" Grid.IsSharedSizeScope="True">
                            <StackPanel x:Name="ScreenPanel">
                                <TextBlock Style="{StaticResource Rl.Muted}" Text="{DynamicResource Loc.screen.hint}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.screen.smooth}"/>
                                    <Slider x:Name="SmoothSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Smooth_Changed"/>
                                    <TextBlock x:Name="SmoothValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.screen.saturation}"/>
                                    <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="0" Maximum="200" VerticalAlignment="Center" ValueChanged="Saturation_Changed"/>
                                    <TextBlock x:Name="SaturationValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.capture.label}"/>
                                    <ComboBox x:Name="CaptureBox" Grid.Column="1" SelectionChanged="Capture_Changed"/>
                                    <Button Grid.Column="2" Style="{StaticResource Rl.Button}" Margin="10,0,0,0" MinHeight="32" Padding="14,4" Click="Test_Click"
                                            ToolTip="{DynamicResource Loc.test.tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE8B0;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                            <TextBlock Text="{DynamicResource Loc.test.button}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="CaptureInfo" Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="ColorPanel" Visibility="Collapsed">
                                <WrapPanel x:Name="Swatches" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.color.hue}"/>
                                    <Slider x:Name="HueSlider" Grid.Column="1" Style="{StaticResource Rl.Slider.Hue}" VerticalAlignment="Center" ValueChanged="Hue_Changed"/>
                                    <Border x:Name="ColorPreview" Grid.Column="2" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Right"
                                            BorderThickness="1" BorderBrush="{DynamicResource Rl.Border}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="RainbowPanel" Visibility="Collapsed">
                                <!-- Плейлист: переливы сменяют друг друга сами -->
                                <Grid Margin="0,0,0,10">
                                    <ToggleButton x:Name="PlaylistToggle" Style="{StaticResource Rl.Power}" HorizontalAlignment="Left"
                                                  Content="{DynamicResource Loc.fx.playlist}" Checked="Playlist_Changed" Unchecked="Playlist_Changed"/>
                                    <StackPanel x:Name="PlaylistTiming" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Rl.FieldLabel}" Margin="0,0,8,0" Text="{DynamicResource Loc.fx.every}"/>
                                        <c:NumberSpinner x:Name="PlaylistSeconds" Minimum="5" Maximum="3600" Width="86"/>
                                        <TextBlock Style="{StaticResource Rl.FieldLabel}" Margin="8,0,0,0" Text="{DynamicResource Loc.fx.sec}"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Свёрнутый вид: текущий перелив; щелчок раскрывает все переливы -->
                                <Button Click="EffectSummary_Click" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        AutomationProperties.Name="{DynamicResource Loc.fx.choose}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Border x:Name="EffectSummary" CornerRadius="8" BorderThickness="1" Padding="6"
                                        BorderBrush="{DynamicResource Rl.Border}" Background="{DynamicResource Rl.Input}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <c:EffectPreview x:Name="SummaryPreview" Height="54"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SummaryName" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Rl.Accent}"/>
                                            <TextBlock x:Name="SummaryHint" Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="SummaryChevron" Grid.Column="2" Style="{StaticResource Rl.Icon}" FontSize="12" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Rl.Text.Muted}" Text="&#xE70D;"/>
                                    </Grid>
                                </Border>
                                </Button>
                                <StackPanel x:Name="EffectGallery" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="EffectHint" Style="{StaticResource Rl.Muted}" FontSize="11" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <!-- Плейлист: снять все отметки / отметить все -->
                                        <Button x:Name="PlaylistAllButton" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Rl.Button.Icon}"
                                                Width="28" Height="28" MinHeight="28" Click="PlaylistAll_Click" VerticalAlignment="Center">
                                            <Path Width="16" Height="12" Stretch="Uniform" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Stroke="{DynamicResource Rl.Accent}" Data="M1,6.5 L4.5,10 L11.5,2 M7.5,9 L8.5,10 L15.5,2"/>
                                        </Button>
                                    </Grid>
                                    <ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
                                        <WrapPanel x:Name="EffectTiles" Margin="0,0,4,0"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="MicPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Rl.Muted}" Text="{DynamicResource Loc.mic.hint}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.mic.device}"/>
                                    <ComboBox x:Name="MicBox" Grid.Column="1" SelectionChanged="Mic_Changed"/>
                                    <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Rl.Button.Icon}" Content="&#xE713;" Click="MicSettings_Click"
                                            ToolTip="{DynamicResource Loc.micset.title}" AutomationProperties.Name="{DynamicResource Loc.micset.title}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.music.sensitivity}"/>
                                    <Slider x:Name="MicSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="MicSens_Changed"/>
                                    <TextBlock x:Name="MicValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.micset.gate}"/>
                                    <Slider x:Name="GateSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Gate_Changed"
                                            ToolTip="{DynamicResource Loc.micset.gate.hint}"/>
                                    <TextBlock x:Name="GateValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <CheckBox x:Name="AutoGateBox" Margin="0,0,0,10" HorizontalAlignment="Left" Content="{DynamicResource Loc.mic.autogate}"
                                          ToolTip="{DynamicResource Loc.mic.autogate.tip}" Click="AutoGate_Click"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.mic.level}"/>
                                    <Grid x:Name="MicTrack" Grid.Column="1" Height="14" VerticalAlignment="Center">
                                        <Border Height="8" CornerRadius="4" Background="{DynamicResource Rl.Track}"/>
                                        <Border x:Name="MicMeter" Height="8" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource Rl.Accent}"/>
                                        <!-- Порог тишины: всё левее отметки лента считает тишиной -->
                                        <Border x:Name="GateMark" Width="2" HorizontalAlignment="Left" Background="{DynamicResource Rl.Status.Warn}"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="MicError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{DynamicResource Rl.Status.Bad}"/>
                            </StackPanel>

                            <StackPanel x:Name="MusicPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Rl.Muted}" Text="{DynamicResource Loc.music.hint}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.music.sensitivity}"/>
                                    <Slider x:Name="MusicSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Music_Changed"/>
                                    <TextBlock x:Name="MusicValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="MusicError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{DynamicResource Rl.Status.Bad}"/>
                            </StackPanel>
                            <!-- Кино: цвета картинки без чёрных полос, глубже к центру, плюс плавное «дыхание» от звука -->
                            <StackPanel x:Name="CinemaPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Rl.Muted}" Text="{DynamicResource Loc.cinema.hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.screen.smooth}"/>
                                    <Slider x:Name="CinemaSmoothSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="CinemaSmooth_Changed"/>
                                    <TextBlock x:Name="CinemaSmoothValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.cinema.depth}"/>
                                    <Slider x:Name="CinemaDepthSlider" Grid.Column="1" Minimum="5" Maximum="50" VerticalAlignment="Center" ValueChanged="CinemaDepth_Changed"/>
                                    <TextBlock x:Name="CinemaDepthValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeLabel"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.cinema.sound}"/>
                                    <Slider x:Name="CinemaSoundSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="CinemaSound_Changed"/>
                                    <TextBlock x:Name="CinemaSoundValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <ToggleButton x:Name="CinemaBarsToggle" Style="{StaticResource Rl.Power}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Content="{DynamicResource Loc.cinema.bars}" ToolTip="{DynamicResource Loc.cinema.bars.tip}"
                                                  Checked="CinemaBars_Changed" Unchecked="CinemaBars_Changed"/>
                                    <Button Style="{StaticResource Rl.Button}" HorizontalAlignment="Right" MinHeight="32" Padding="14,4" Click="CinemaTest_Click"
                                            ToolTip="{DynamicResource Loc.cinema.test.tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE8B0;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                            <TextBlock Text="{DynamicResource Loc.test.button}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="CinemaInfo" Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,8,0,0"/>
                                <TextBlock x:Name="CinemaError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Rl.Status.Bad}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LightHint" Visibility="Collapsed" Style="{StaticResource Rl.Muted}" FontSize="11"
                                   Margin="0,10,0,0" Text="{DynamicResource Loc.light.wait}"/>
                        <!-- Сработало исключение: игра запущена или плеер впереди — вместо режима работает другое действие -->
                        <TextBlock x:Name="ExclusionStatus" Visibility="Collapsed" Style="{StaticResource Rl.Muted}" FontSize="11"
                                   Margin="0,8,0,0" Foreground="{DynamicResource Rl.Status.Warn}"/>
                    </StackPanel>
                </Border>

                <!-- Расположение светодиодов и экран с лентой -->
                <Border Style="{StaticResource Rl.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Rl.SectionTitle}" Text="{DynamicResource Loc.sec.layout}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Rl.FieldLabel}" Text="{DynamicResource Loc.screen.label}"/>
                            <ComboBox x:Name="ScreenBox" Grid.Column="1" SelectionChanged="Screen_Changed"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <c:LayoutPicture x:Name="Preview" Compact="True" Height="104" Margin="-6,-4,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LayoutTotal" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LayoutSummary" Style="{StaticResource Rl.Muted}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LayoutKnown" Style="{StaticResource Rl.Muted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <!-- Три кнопки одной ширины: расположение, подсчёт, исключения -->
                        <UniformGrid Rows="1" Margin="0,12,0,0">
                            <Button Style="{StaticResource Rl.Button.Accent}" Click="Setup_Click" Margin="0,0,8,0"
                                    ToolTip="{DynamicResource Loc.layout.setup.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE7F4;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                    <TextBlock Text="{DynamicResource Loc.layout.setup}" Foreground="{DynamicResource Rl.Accent}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Rl.Button}" Click="Find_Click" Margin="0,0,8,0"
                                    ToolTip="{DynamicResource Loc.layout.find.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE8EF;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                    <TextBlock Text="{DynamicResource Loc.layout.find}"/>
                                </StackPanel>
                            </Button>
                        <!-- Исключения: программы, при которых экран не захватывается -->
                        <Button Style="{StaticResource Rl.Button}" Click="Exclusions_Click"
                                AutomationProperties.Name="{DynamicResource Loc.ex.button}" ToolTip="{DynamicResource Loc.ex.subtitle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Rl.Icon}" Text="&#xE71C;" Margin="0,0,8,0" Foreground="{DynamicResource Rl.Accent}"/>
                                <TextBlock Text="{DynamicResource Loc.ex.button}"/>
                            </StackPanel>
                        </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
