<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
    <!-- Тёмная тема: та же палитра, что у ReSwitch / ReQuit / ReFlow / ReIcon -->
    <Color x:Key="Rl.Color.Background">#0D1117</Color>
    <Color x:Key="Rl.Color.Surface">#161B22</Color>
    <Color x:Key="Rl.Color.Border">#30363D</Color>
    <Color x:Key="Rl.Color.TextPrimary">#E6EDF3</Color>
    <Color x:Key="Rl.Color.TextMuted">#8B949E</Color>
    <Color x:Key="Rl.Color.Accent">#3DD4C3</Color>

    <SolidColorBrush x:Key="Rl.Window.Background" Color="#0D1117"/>
    <SolidColorBrush x:Key="Rl.Surface" Color="#161B22"/>
    <SolidColorBrush x:Key="Rl.Input" Color="#0F141A"/>
    <SolidColorBrush x:Key="Rl.Border" Color="#30363D"/>
    <SolidColorBrush x:Key="Rl.Text.Primary" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="Rl.Text.Muted" Color="#8B949E"/>
    <SolidColorBrush x:Key="Rl.Accent" Color="#3DD4C3"/>
    <SolidColorBrush x:Key="Rl.Accent.Dim" Color="#1F6F65"/>
    <SolidColorBrush x:Key="Rl.Button.Accent.Background" Color="#122A28"/>
    <SolidColorBrush x:Key="Rl.Button.PressedBackground" Color="#1C2128"/>
    <SolidColorBrush x:Key="Rl.Hover" Color="#2D333B"/>
    <SolidColorBrush x:Key="Rl.Pressed" Color="#3D444D"/>
    <SolidColorBrush x:Key="Rl.Track" Color="#262C34"/>
    <SolidColorBrush x:Key="Rl.Check.Background" Color="#1A3D38"/>
    <SolidColorBrush x:Key="Rl.Close.Hover" Color="#E81123"/>
    <SolidColorBrush x:Key="Rl.Close.Pressed" Color="#C50F1F"/>
    <SolidColorBrush x:Key="Rl.Close.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Rl.Status.Good" Color="#5CE88A"/>
    <SolidColorBrush x:Key="Rl.Status.Warn" Color="#E8C15C"/>
    <SolidColorBrush x:Key="Rl.Status.Bad" Color="#F2695C"/>
    <SolidColorBrush x:Key="Rl.Status.Idle" Color="#6E7681"/>
    <SolidColorBrush x:Key="Rl.Preview.Screen" Color="#0B0F14"/>

    <!-- Выпадающие списки и Popup берут SystemColors — подменяем под тему -->
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowBrushKey}" Color="#161B22"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowTextBrushKey}" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="#2D333B"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlBrushKey}" Color="#161B22"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlDarkBrushKey}" Color="#30363D"/>
</ResourceDictionary>
